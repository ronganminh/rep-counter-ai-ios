# ============================================================
# Video tập luyện — TUYỆT ĐỐI không đưa lên
# ============================================================
# Đây là dữ liệu cá nhân nhạy cảm, và IMPLEMENTATION_PLAN §18 cấm upload video
# lên dịch vụ bên ngoài. Chặn theo cả thư mục lẫn đuôi file để một file quay
# thêm sau này không lọt qua.
push_up/
*.MOV
*.mov
*.mp4
*.avi
*.mkv
*.m4v
*.webm

# Dữ liệu trung gian sinh từ video (landmark, keypoint) — file lớn, tái tạo được
*.npz
*.npy

