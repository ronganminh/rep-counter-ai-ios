# Copy this file to .env and fill the server-side provider settings.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required production privacy contract: billing_enabled
# Before setting this, verify the exact Google project's Billing Tier/Plan
# in Google AI Studio. This value is a runtime guard, not proof by itself.
GEMINI_SERVICE_MODE=

PORT=8787
BIND_HOST=127.0.0.1
