# Copy this file to .env and fill the server-side provider settings.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Legacy optional provider. RepCoach production does not use Gemini while its
# project is on the unpaid tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SERVICE_MODE=

PORT=8787
BIND_HOST=127.0.0.1
