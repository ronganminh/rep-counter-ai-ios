# Copy this file to .env and fill the server-side provider settings.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required runtime guard: unpaid | billing_enabled
# This value must match the exact Google project's verified AI Studio billing state.
# It is documentation/guard metadata and is not proof of billing by itself.
GEMINI_SERVICE_MODE=

PORT=8787
BIND_HOST=127.0.0.1
