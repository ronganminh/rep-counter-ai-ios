[Unit]
Description=RepCoach AI workout feedback backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nduythanh
Group=nduythanh
WorkingDirectory=/home/nduythanh/apps/repcoach-backend
EnvironmentFile=/home/nduythanh/apps/repcoach-backend/.env
ExecStart=/usr/bin/python3 /home/nduythanh/apps/repcoach-backend/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
