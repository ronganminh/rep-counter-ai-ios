  },
  "privCameraBody": "The app uses your camera to detect body pose and count repetitions. Live camera frames and landmarks used for counting are processed on-device. Camera images, workout video and raw landmark coordinates are not sent to the backend for rep counting or AI feedback.",
  "@privCameraBody": {
    "description": "Existing shipping string S.privCameraBody [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privWorkoutTitle": "Workout data",
  "@privWorkoutTitle": {
    "description": "Existing shipping string S.privWorkoutTitle [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privWorkoutBody": "Workout history is stored locally and can include reps, sets, duration, goals, pose/quality statistics, per-rep detail, calibration and returned AI feedback. The history store keeps up to the latest 100 readable workout records.",
  "@privWorkoutBody": {
    "description": "Existing shipping string S.privWorkoutBody [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privAiTitle": "AI feedback",
  "@privAiTitle": {
    "description": "Existing shipping string S.privAiTitle [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privAiBody": "When you request AI feedback or opt in to automatic feedback, the app sends a limited summary including exercise, goal, reps/sets, duration, pose statistics and quality metrics to the RepCoach AI backend. Production sends the minimized prompt to GroqCloud using an API key stored only on the server. No images, video, audio or raw landmark coordinates are sent.",
  "@privAiBody": {
    "description": "Existing shipping string S.privAiBody [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privRetentionTitle": "Data retention and deletion",
  "@privRetentionTitle": {
    "description": "Existing shipping string S.privRetentionTitle [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privRetentionBody": "Workout history and saved AI feedback remain on your device until deleted in the app, app storage is cleared, or the app is uninstalled. The backend does not intentionally keep workout bodies/prompts/responses as server history. Nginx logs rotate daily with the current log plus 14 rotations; backend metadata also enters the host system journal under VPS retention settings.",
  "@privRetentionBody": {
    "description": "Existing shipping string S.privRetentionBody [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privSecurityTitle": "Security and processors",
  "@privSecurityTitle": {
    "description": "Existing shipping string S.privSecurityTitle [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privSecurityBody": "AI data is sent over HTTPS. RepCoach production uses GroqCloud. Under GroqCloud's current documentation, inference customer data is not retained by default except when needed for system reliability or abuse investigation; in those cases it may be retained for up to 30 days. RepCoach does not currently claim Zero Data Retention.",
  "@privSecurityBody": {
    "description": "Existing shipping string S.privSecurityBody [source: repo lib/core/i18n/app_strings.dart; status: existing]"
  },
  "privContactTitle": "Contact",
