        "request": {
          "content_type": "application/json",
          "max_bytes": 16384,
          "schema_version": "1|2 (2 requires consent_version)",
          "core": [
            "exercise",
            "duration_seconds",
            "reps",
            "sets",
            "target_reps",
            "goal_reached",
            "placement_score",
            "pose_frames",
            "pose_lost_frames",
