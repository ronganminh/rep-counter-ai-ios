          "quality": [
            "flagged_reps",
            "avg_rep_sec",
            "avg_amplitude",
            "amplitude_drop_percent",
            "left_right_diff_percent",
            "quality_score",
            "has_enough_data"
          ],
          "example": "rep-counter-ai-main/contracts/workout_feedback_v2.json"
        },
        "response": {
          "200": {
            "schema_version": 1,
            "feedback": "string"
          },
          "errors": {
            "400": "INVALID_REQUEST",
            "405": "INVALID_REQUEST",
            "413": "INVALID_REQUEST",
            "404": "NOT_FOUND",
            "502": "AI_RESPONSE_INVALID",
            "503": "AI_UNAVAILABLE",
            "504": "AI_TIMEOUT",
            "500": "SERVER_ERROR"
          }
        }
      }
    ]
